# QQ 机器人运行镜像。
#
# 构建上下文是仓库根目录，且需要先执行 `rush rebuild`（dist 由 tsdown 产出）：
#   docker build -f deploy/Dockerfile.qqbot -t gt6ce/qqbot .
#
# 镜像里没有源码、没有依赖清单解析、没有包管理器：dist 已内联 @gt6ce/qqbot、
# @gt6ce/shared、QQ SDK 与 zod，运行期只需要 node。
FROM node:22-slim

ENV NODE_ENV=production
WORKDIR /app

COPY apps/qqbot/dist ./dist
COPY apps/qqbot/package.json ./package.json

# stateDir 由命名卷挂载；目录属主提前设为运行用户，首次创建卷时才可写。
RUN mkdir -p /app/state && chown 10001:10001 /app/state

USER 10001:10001
STOPSIGNAL SIGTERM

CMD ["node", "dist/main.js"]
