{
  "server": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "auth": {
    "token": {
      "file": "/run/secrets/rpc-token-github"
    }
  },
  "paths": {
    "config_dir": "/app/repo-config"
  },
  "github": {
    "mode": "token",
    "token": {
      "file": "/run/secrets/github-token"
    }
  },
  "issues": {
    "ttl_ms": 86400000,
    "max_entries": 1000,
    "timeout_ms": 15000
  }
}
