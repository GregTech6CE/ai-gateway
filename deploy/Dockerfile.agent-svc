# 分析服务运行镜像。
#
#   docker build -f deploy/Dockerfile.agent-svc -t gt6ce/agent-svc .
#
# dist 已内联 @gt6ce/agent、@gt6ce/shared、AI SDK、provider 与 zod；
# 配置文件、repos/models/budgets 与 prompts 由 compose 只读挂载。
FROM node:22-slim

ENV NODE_ENV=production
WORKDIR /app

COPY apps/agent-svc/dist ./dist
COPY apps/agent-svc/package.json ./package.json

USER 10001:10001
STOPSIGNAL SIGTERM
EXPOSE 8080

CMD ["node", "dist/main.js"]
